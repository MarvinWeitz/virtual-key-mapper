{
  "name": "vkm",
  "displayName": "Virtual Key Mapper for Copilot Chat",
  "description": "Gateway models in Copilot Chat with your vkm sign-in and each workspace's labels.",
  "version": "0.1.2",
  "publisher": "cbs-consulting",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cbs-consulting/virtual-key-mapper"
  },
  "homepage": "https://github.com/cbs-consulting/virtual-key-mapper#readme",
  "bugs": "https://github.com/cbs-consulting/virtual-key-mapper/issues",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "vkm",
        "displayName": "Virtual Key Mapper"
      }
    ],
    "commands": [
      {
        "command": "vkm.showLabels",
        "title": "Show or assign labels",
        "category": "Virtual Key Mapper"
      },
      {
        "command": "vkm.signIn",
        "title": "Sign in",
        "category": "Virtual Key Mapper"
      },
      {
        "command": "vkm.refresh",
        "title": "Refresh models and labels",
        "category": "Virtual Key Mapper"
      }
    ],
    "configuration": {
      "title": "Virtual Key Mapper",
      "properties": {
        "vkm.command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "vkm"
          ],
          "scope": "machine",
          "markdownDescription": "How to run the `vkm` CLI on this machine (remote windows use the remote machine's own value), e.g. `[\"/path/to/venv/bin/vkm\"]` or `[\"python\", \"-m\", \"virtual_key_mapper\"]`."
        },
        "vkm.profile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Profile to use; empty for the CLI's selected default."
        },
        "vkm.maxInputTokens": {
          "type": "number",
          "default": 128000,
          "description": "Context size advertised to Copilot for gateway models (not discovered from the gateway)."
        },
        "vkm.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "description": "Output limit advertised to Copilot for gateway models."
        },
        "vkm.imageInput": {
          "type": "boolean",
          "default": false,
          "description": "Advertise image input; enable only if your gateway models accept images."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "tsc -p . && node --test \"out/test/*.test.js\"",
    "test:host": "tsc -p . && node test-host/run.js",
    "package": "tsc -p . && vsce package --no-dependencies --out vkm.vsix"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.104.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "7.0.2"
  }
}
